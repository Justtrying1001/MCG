# Neon Postgres connection strings
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# X OAuth 1.0a (required for persistent account login)
X_CONSUMER_KEY=""
X_CONSUMER_SECRET=""
X_REDIRECT_URI="http://localhost:3000/api/auth/x/callback"

# Admin login (required for /admin/* UI)
ADMIN_USERNAME=""
# Format: pbkdf2_sha256$<iterations>$<salt>$<digest>
ADMIN_PASSWORD_HASH=""
# Used to sign admin session cookies
ADMIN_SESSION_SECRET=""

# Optional: keep for machine-to-machine internal API calls
INTERNAL_ADMIN_KEY=""

# QStash (Upstash) — required for scheduled contest lifecycle jobs
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Base URL used to build QStash job callback URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Not required for this implementation:
# X_BEARER_TOKEN is NOT used by the OAuth login flow.
