# Neon Postgres connection strings
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Admin login (required for /admin/* UI)
ADMIN_USERNAME=""
# Format: pbkdf2_sha256$<iterations>$<salt>$<digest>
ADMIN_PASSWORD_HASH=""
# Used to sign admin session cookies
ADMIN_SESSION_SECRET=""
# Optional: force a root owner X username to always be treated as ADMIN_SUPERVISOR
ROOT_ADMIN_X_USERNAME=""
# Backward-compatible alias for the same behavior
OWNER_X_USERNAME=""

# Optional: keep for machine-to-machine internal API calls
INTERNAL_ADMIN_KEY=""

# Explicit safety gate for destructive admin reset endpoint/UI
# Must be exactly "true" to enable reset users action
ENABLE_USER_RESET="false"

# QStash (Upstash) — required for scheduled contest lifecycle jobs
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Optional fallback poller for contest lifecycle. Defaults to enabled when QStash is absent.
# Set to "0" to disable explicitly, or "1" to force-enable alongside QStash.
ENABLE_CONTEST_LIFECYCLE_SCHEDULER=""
CONTEST_LIFECYCLE_SCHEDULER_INTERVAL_MS="60000"

# Base URL override for local/non-Vercel environments.
# Production canonical/public origin is always https://memecardgame.com.
# Vercel preview deployments automatically use their preview URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""
# Required for Privy web wallet fallback on mobile browsers (via wallet_connect).
# Get a project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
