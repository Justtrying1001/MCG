{
  "name": "mcg-mvp-v1",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "prisma generate && tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "vercel-build": "npm run prisma:deploy:schema && prisma generate && npm run bootstrap:mvp:cloud:deploy && next build",
    "prisma:push:reset": "prisma db push --force-reset",
    "seed:mvp:controlled-emission": "node prisma/seed-mvp-controlled-emission.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:token-master-50": "node scripts/build-token-master-50.mjs",
    "check:mvp:bootstrap": "node prisma/check-mvp-bootstrap.mjs",
    "bootstrap:mvp:cloud": "npm run seed:mvp:controlled-emission && npm run check:mvp:bootstrap",
    "check:mvp:bootstrap:allow-exhausted": "node prisma/check-mvp-bootstrap.mjs --allow-exhausted",
    "bootstrap:mvp:cloud:deploy": "npm run seed:mvp:controlled-emission && npm run check:mvp:bootstrap:allow-exhausted",
    "seed:milestone:rewards": "node prisma/seed-milestone-rewards.mjs",
    "audit:milestone:rewards": "node prisma/audit-milestone-rewards.mjs",
    "prisma:deploy:schema": "node prisma/deploy-schema.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@upstash/qstash": "^2.9.0",
    "@vercel/analytics": "^1.6.1",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.33",
    "prisma": "^5.22.0",
    "typescript": "^5.5.4",
    "vitest": "^4.0.18"
  }
}
