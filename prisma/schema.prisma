generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  privyUserId  String?       @unique
  xUserId      String        @unique
  inviteCode   String        @unique
  xUsername    String
  displayName  String
  avatarUrl    String?
  authProvider String        @default("x")
  points       Int           @default(300)
  packsOpened  Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cards        UserCard[]
  packOpenings PackOpening[]
  sessions     UserSession[]
  events       Event[]

  // Target-domain foundations (active)
  ownedCardInstances         OwnedCardInstance[]
  packOpeningEvents          PackOpeningEvent[]
  rewardGrants               RewardGrant[]
  rewardLedgerEntries        RewardLedgerEntry[]
  userQuestProgress          UserQuestProgress[]
  questSubmissions           QuestSubmission[]
  contestEntries             ContestEntry[]
  contestScores              ContestScore[]
  contestRankings            ContestRanking[]
  contestSettlementPlanItems ContestSettlementPlanItem[]
  userProgression            UserProgression?
  collectionProgressions     CollectionProgression[]
  competitiveProgression     CompetitiveProgression?
  leagueId                   String?
  league                     League?                     @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  seasonRatings              UserContestRating[]
  contestRatingChanges       ContestRatingChange[]
  seasonLeaderboards         SeasonLeaderboard[]
  seasonRewardGrants         SeasonRewardGrant[]
  sentInvites                UserInvite[]                @relation("UserInvitesSent")
  receivedInvite             UserInvite?                 @relation("UserInviteReceived")
}

model Event {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  visitorId String?
  userId    String?
  isGuest   Boolean            @default(true)
  createdAt DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
  @@index([isGuest, createdAt])
}

model UserInvite {
  id         String   @id @default(cuid())
  inviterId  String
  inviteeId  String   @unique
  inviteCode String
  createdAt  DateTime @default(now())

  inviter User @relation("UserInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("UserInviteReceived", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([inviterId, inviteeId])
  @@index([inviterId])
  @@index([inviteCode])
}

model UserSession {
  id               String   @id @default(cuid())
  userId           String
  sessionTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserCard {
  id         String   @id @default(cuid())
  userId     String
  baseCardId String
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, baseCardId])
  @@index([userId])
}

model PackOpening {
  id        String   @id @default(cuid())
  userId    String
  packType  String
  result    Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Target-domain foundations (currently active alongside legacy continuity models) ---

enum RarityTier {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum EditionType {
  BASE
  REVERSE
  BRILLANTE
  HOLO
  FULL_ART
}

enum PackSource {
  SALE
  REWARD
}

enum RewardType {
  POINTS
  PACK
  CARD_INSTANCE
  XP
}

enum RewardLedgerEntryType {
  CREDIT
  DEBIT
}

enum RewardLedgerReasonType {
  WELCOME_REWARD
  PACK_OPEN
  QUEST_REWARD
  CONTEST_REWARD
  CONTEST_ENTRY_FEE
  ADMIN_GRANT
  ADJUSTMENT
}

enum AnalyticsEventType {
  PAGE_VIEW
  CLICK_OPEN_PACK
  LOGIN
  PACK_OPEN
}

enum ContestTeamSizeMode {
  EXACT
}

enum ContestEligibilityMode {
  ANY
  CARD_SET_ONLY
}

enum ContestRewardPolicyStatus {
  DRAFT
  PUBLISHED
}

enum ContestRewardType {
  POINTS
  PACK
  XP
}

enum ContestRewardDistributionRuleType {
  FIXED_RANKS
  TOP_N
  TOP_PERCENT
  POINTS_POOL_TOP_PERCENT
}

enum ContestSettlementPlanStatus {
  DRAFT
  EXECUTED
  CANCELED
}

enum QuestType {
  WELCOME
  SOCIAL_FOLLOW_X
  SOCIAL_ENGAGEMENT_X
  CONTEST_COUNT_MILESTONE
  MANUAL
}

enum QuestValidationMode {
  AUTO
  SUBMIT
  MANUAL_REVIEW
}

enum UserQuestStatus {
  AVAILABLE
  IN_PROGRESS
  CLAIMABLE
  COMPLETED
  REJECTED
}

enum QuestSubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum ContestStatus {
  DRAFT
  OPEN
  LOCKED
  LIVE
  SETTLED
  CANCELED
}

enum ContestEntryStatus {
  SUBMITTED
  SCORED
  SETTLED
  CANCELED
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum LeagueTier {
  BRONZE
  SILVER
  GOLD
  DIAMOND
  LEGEND
}

model TokenProject {
  id          String   @id @default(cuid())
  slug        String   @unique
  coingeckoId String?  @unique
  displayName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cardTemplates          CardTemplate[]
  contestTokenSnapshots  ContestTokenSnapshot[]
  contestTokenScores     ContestTokenScore[]
  contestEntryBreakdowns ContestEntryScoreBreakdown[]
}

enum ContestSnapshotPhase {
  START
  END
}

model CardSet {
  id          String   @id @default(cuid())
  code        String   @unique
  displayName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cardTemplates      CardTemplate[]
  packDefinitions    PackDefinition[]
  contestRules       ContestRule[]
  collectionProgress CollectionProgression[]
}

model Rarity {
  id        String     @id @default(cuid())
  code      RarityTier @unique
  weight    Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  cardTemplates CardTemplate[]
  dropTableRows DropTableRow[]
}

model Edition {
  id        String      @id @default(cuid())
  code      EditionType @unique
  weight    Int         @default(1)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  cardTemplates CardTemplate[]
  dropTableRows DropTableRow[]
}

model CardTemplate {
  id             String   @id @default(cuid())
  tokenProjectId String
  cardSetId      String
  rarityId       String
  editionId      String
  name           String
  imageUrl       String?
  metadata       Json?
  plannedSupply  Int      @default(0)
  issuedSupply   Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tokenProject TokenProject @relation(fields: [tokenProjectId], references: [id], onDelete: Restrict)
  cardSet      CardSet      @relation(fields: [cardSetId], references: [id], onDelete: Restrict)
  rarity       Rarity       @relation(fields: [rarityId], references: [id], onDelete: Restrict)
  edition      Edition      @relation(fields: [editionId], references: [id], onDelete: Restrict)

  ownedCardInstances OwnedCardInstance[]

  @@unique([tokenProjectId, cardSetId, rarityId, editionId])
  @@index([tokenProjectId])
  @@index([cardSetId])
}

model OwnedCardInstance {
  id                       String   @id @default(cuid())
  userId                   String
  cardTemplateId           String
  sourcePackOpeningEventId String?
  acquiredAt               DateTime @default(now())
  metadata                 Json?

  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardTemplate           CardTemplate                 @relation(fields: [cardTemplateId], references: [id], onDelete: Restrict)
  sourcePackOpeningEvent PackOpeningEvent?            @relation(fields: [sourcePackOpeningEventId], references: [id], onDelete: SetNull)
  contestRosterLocks     RosterLock[]
  contestScoreBreakdowns ContestEntryScoreBreakdown[]

  @@index([userId])
  @@index([cardTemplateId])
}

model PackDefinition {
  id               String     @id @default(cuid())
  code             String     @unique
  displayName      String
  cardSetId        String
  source           PackSource @default(SALE)
  plannedPackCount Int        @default(0)
  openedPackCount  Int        @default(0)
  cardsPerPack     Int        @default(5)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  cardSet                 CardSet                  @relation(fields: [cardSetId], references: [id], onDelete: Restrict)
  dropTables              DropTable[]
  packOpeningEvents       PackOpeningEvent[]
  rewardGrants            RewardGrant[]
  contestRewardComponents ContestRewardComponent[]
  questRewards            QuestDefinition[]        @relation("QuestPackReward")

  @@index([cardSetId])
}

model RewardPackSupply {
  id            String   @id
  totalSupply   Int
  distributed   Int      @default(0)
  lastUpdatedAt DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model RuntimeConfig {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DropTable {
  id               String   @id @default(cuid())
  packDefinitionId String
  name             String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  packDefinition PackDefinition @relation(fields: [packDefinitionId], references: [id], onDelete: Cascade)
  rows           DropTableRow[]

  @@index([packDefinitionId])
}

model DropTableRow {
  id          String @id @default(cuid())
  dropTableId String
  rarityId    String
  editionId   String
  weight      Int

  dropTable DropTable @relation(fields: [dropTableId], references: [id], onDelete: Cascade)
  rarity    Rarity    @relation(fields: [rarityId], references: [id], onDelete: Restrict)
  edition   Edition   @relation(fields: [editionId], references: [id], onDelete: Restrict)

  @@index([dropTableId])
  @@index([rarityId])
  @@index([editionId])
}

model PackOpeningEvent {
  id               String   @id @default(cuid())
  userId           String
  packDefinitionId String
  openedAt         DateTime @default(now())

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  packDefinition   PackDefinition      @relation(fields: [packDefinitionId], references: [id], onDelete: Restrict)
  awardedInstances OwnedCardInstance[]
  rewardGrants     RewardGrant[]

  @@index([userId])
  @@index([packDefinitionId])
}

model RewardGrant {
  id                        String     @id @default(cuid())
  userId                    String
  type                      RewardType
  amount                    Int?
  packDefinitionId          String?
  sourcePackOpeningEventId  String?
  sourceContestSettlementId String?
  claimedAt                 DateTime?
  createdAt                 DateTime   @default(now())

  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  packDefinition          PackDefinition?    @relation(fields: [packDefinitionId], references: [id], onDelete: SetNull)
  sourcePackOpeningEvent  PackOpeningEvent?  @relation(fields: [sourcePackOpeningEventId], references: [id], onDelete: SetNull)
  sourceContestSettlement ContestSettlement? @relation(fields: [sourceContestSettlementId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([claimedAt])
}

model RewardLedgerEntry {
  id             String                 @id @default(cuid())
  userId         String
  entryType      RewardLedgerEntryType
  amount         Int
  reasonType     RewardLedgerReasonType
  reasonRef      String?
  idempotencyKey String?                @unique
  metadata       Json?
  createdAt      DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reasonType])
}

model QuestDefinition {
  id                     String              @id @default(cuid())
  code                   String              @unique
  type                   QuestType
  title                  String
  description            String?
  rewardPoints           Int                 @default(0)
  rewardPackDefinitionId String?
  rewardPackQuantity     Int                 @default(1)
  validationMode         QuestValidationMode
  oneTime                Boolean             @default(true)
  isActive               Boolean             @default(true)
  startAt                DateTime?
  endAt                  DateTime?
  config                 Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  rewardPackDefinition PackDefinition?     @relation("QuestPackReward", fields: [rewardPackDefinitionId], references: [id], onDelete: SetNull)
  userProgressions     UserQuestProgress[]
  submissions          QuestSubmission[]

  @@index([rewardPackDefinitionId])
}

model UserQuestProgress {
  id            String          @id @default(cuid())
  userId        String
  questId       String
  status        UserQuestStatus @default(AVAILABLE)
  progressValue Int             @default(0)
  completedAt   DateTime?
  claimedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest QuestDefinition @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
  @@index([questId])
}

model QuestSubmission {
  id              String                @id @default(cuid())
  userId          String
  questId         String
  status          QuestSubmissionStatus @default(SUBMITTED)
  proofUrl        String?
  note            String?
  reviewedByAdmin String?
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest QuestDefinition @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questId])
  @@index([status])
}

model Season {
  id        String       @id @default(cuid())
  name      String       @unique
  startsAt  DateTime
  endsAt    DateTime
  status    SeasonStatus @default(UPCOMING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  contests        Contest[]
  userRatings     UserContestRating[]
  leaderboardRows SeasonLeaderboard[]
  ratingChanges   ContestRatingChange[]
  rewardGrants    SeasonRewardGrant[]

  @@index([status, startsAt])
}

model League {
  id        String     @id @default(cuid())
  name      String     @unique
  tier      LeagueTier @unique
  minRating Int
  maxRating Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users User[]

  @@index([minRating, maxRating])
}

model Contest {
  id                 String        @id @default(cuid())
  code               String        @unique
  title              String
  description        String?
  status             ContestStatus @default(DRAFT)
  configPublishedAt  DateTime?
  openAt             DateTime?
  liveAt             DateTime?
  lockAt             DateTime?
  endsAt             DateTime?
  qstashOpenJobId    String?
  qstashLiveJobId    String?
  qstashSettleJobId  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  seasonId           String?
  leagueTierRequired LeagueTier?

  season          Season?                 @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  rules           ContestRule[]
  entries         ContestEntry[]
  scores          ContestScore[]
  rankings        ContestRanking[]
  settlements     ContestSettlement[]
  rewardPolicy    ContestRewardPolicy?
  settlementPlans ContestSettlementPlan[]
  tokenSnapshots  ContestTokenSnapshot[]
  tokenScores     ContestTokenScore[]
  ratingChanges   ContestRatingChange[]
}

model ContestRule {
  id               String                 @id @default(cuid())
  contestId        String
  cardSetId        String?
  maxRosterSize    Int?
  teamSizeMode     ContestTeamSizeMode    @default(EXACT)
  eligibilityMode  ContestEligibilityMode @default(ANY)
  entryFeeEnabled  Boolean                @default(false)
  entryFeeCurrency String                 @default("POINTS")
  entryFeeAmount   Int?
  config           Json?

  contest Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  cardSet CardSet? @relation(fields: [cardSetId], references: [id], onDelete: SetNull)

  @@index([contestId])
}

model ContestRewardPolicy {
  id        String                    @id @default(cuid())
  contestId String                    @unique
  status    ContestRewardPolicyStatus @default(DRAFT)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  contest           Contest                         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  bundles           ContestRewardBundle[]
  distributionRules ContestRewardDistributionRule[]
}

model ContestRewardBundle {
  id             String   @id @default(cuid())
  rewardPolicyId String
  name           String
  priority       Int      @default(0)
  createdAt      DateTime @default(now())

  rewardPolicy      ContestRewardPolicy             @relation(fields: [rewardPolicyId], references: [id], onDelete: Cascade)
  components        ContestRewardComponent[]
  distributionRules ContestRewardDistributionRule[]

  @@index([rewardPolicyId])
}

model ContestRewardComponent {
  id               String            @id @default(cuid())
  bundleId         String
  type             ContestRewardType
  pointsAmount     Int?
  xpAmount         Int?
  packDefinitionId String?
  packQuantity     Int?

  bundle         ContestRewardBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  packDefinition PackDefinition?     @relation(fields: [packDefinitionId], references: [id], onDelete: SetNull)

  @@index([bundleId])
}

model ContestRewardDistributionRule {
  id             String                            @id @default(cuid())
  rewardPolicyId String
  bundleId       String
  priority       Int
  ruleType       ContestRewardDistributionRuleType
  rankFrom       Int?
  rankTo         Int?
  topN           Int?
  topPercent     Float?
  poolAmount     Int?

  rewardPolicy ContestRewardPolicy @relation(fields: [rewardPolicyId], references: [id], onDelete: Cascade)
  bundle       ContestRewardBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([rewardPolicyId, priority])
}

model ContestEntry {
  id          String             @id @default(cuid())
  contestId   String
  userId      String
  status      ContestEntryStatus @default(SUBMITTED)
  submittedAt DateTime           @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  rosterLocks     RosterLock[]
  scoreBreakdowns ContestEntryScoreBreakdown[]

  @@unique([contestId, userId])
  @@index([contestId])
  @@index([userId])
}

model RosterLock {
  id                  String   @id @default(cuid())
  contestEntryId      String
  ownedCardInstanceId String
  lockedAt            DateTime @default(now())

  contestEntry      ContestEntry                 @relation(fields: [contestEntryId], references: [id], onDelete: Cascade)
  ownedCardInstance OwnedCardInstance            @relation(fields: [ownedCardInstanceId], references: [id], onDelete: Restrict)
  scoreBreakdowns   ContestEntryScoreBreakdown[]

  @@unique([contestEntryId, ownedCardInstanceId])
  @@index([ownedCardInstanceId])
}

model ContestTokenSnapshot {
  id                  String               @id @default(cuid())
  contestId           String
  tokenProjectId      String
  geckoId             String
  phase               ContestSnapshotPhase
  priceUsd            Decimal?             @db.Decimal(20, 8)
  marketCapUsd        Decimal?             @db.Decimal(30, 8)
  volume24hUsd        Decimal?             @db.Decimal(30, 8)
  marketCapRank       Int?
  marketDataUpdatedAt DateTime?
  capturedAt          DateTime             @default(now())
  provider            String               @default("COINGECKO")
  capturedCount       Int                  @default(0)
  missingCount        Int                  @default(0)

  contest      Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  tokenProject TokenProject @relation(fields: [tokenProjectId], references: [id], onDelete: Restrict)

  @@unique([contestId, tokenProjectId, phase])
  @@index([contestId, phase])
  @@index([geckoId])
}

model ContestTokenScore {
  id              String   @id @default(cuid())
  contestId       String
  tokenProjectId  String
  score           Float
  priceChange     Float?
  marketCapChange Float?
  volumeChange    Float?
  rankChange      Float?
  computedAt      DateTime @default(now())

  contest      Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  tokenProject TokenProject @relation(fields: [tokenProjectId], references: [id], onDelete: Restrict)

  @@unique([contestId, tokenProjectId])
  @@index([contestId, score])
}

model ContestEntryScoreBreakdown {
  id                String   @id @default(cuid())
  entryId           String
  tokenProjectId    String
  cardInstanceId    String
  rosterLockId      String
  baseScore         Float
  rarityMultiplier  Float
  editionMultiplier Float
  finalScore        Float
  dataQuality       String   @default("COMPLETE")
  computedAt        DateTime @default(now())

  entry        ContestEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tokenProject TokenProject      @relation(fields: [tokenProjectId], references: [id], onDelete: Restrict)
  cardInstance OwnedCardInstance @relation(fields: [cardInstanceId], references: [id], onDelete: Restrict)
  rosterLock   RosterLock        @relation(fields: [rosterLockId], references: [id], onDelete: Cascade)

  @@unique([entryId, cardInstanceId])
  @@index([entryId])
  @@index([tokenProjectId])
}

model ContestScore {
  id        String   @id @default(cuid())
  contestId String
  userId    String
  score     Float
  scoredAt  DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([contestId])
}

model ContestRanking {
  id        String   @id @default(cuid())
  contestId String
  userId    String
  rank      Int
  score     Float
  rankedAt  DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([contestId, rank])
}

model ContestSettlement {
  id        String   @id @default(cuid())
  contestId String
  settledAt DateTime @default(now())

  contest      Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  rewardGrants RewardGrant[]

  @@unique([contestId])
}

model ContestSettlementPlan {
  id                  String                      @id @default(cuid())
  contestId           String
  status              ContestSettlementPlanStatus @default(DRAFT)
  source              String                      @default("AUTO_POLICY_V1")
  policySnapshot      Json?
  rankingSnapshotSize Int                         @default(0)
  generatedAt         DateTime                    @default(now())
  executedAt          DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  contest Contest                     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  items   ContestSettlementPlanItem[]

  @@index([contestId, createdAt])
  @@index([status, createdAt])
}

model ContestSettlementPlanItem {
  id               String   @id @default(cuid())
  planId           String
  userId           String
  rank             Int
  sourceRuleId     String?
  sourceRuleType   String?
  sourceBundleId   String?
  rewardComponents Json
  pointsTotal      Int      @default(0)
  xpTotal          Int      @default(0)
  packsTotal       Int      @default(0)
  createdAt        DateTime @default(now())

  plan ContestSettlementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@index([planId, rank])
}

model UserContestRating {
  id            String   @id @default(cuid())
  userId        String
  seasonId      String
  rating        Int      @default(1200)
  lastUpdatedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([seasonId, rating])
}

model ContestRatingChange {
  id          String   @id @default(cuid())
  contestId   String
  seasonId    String
  userId      String
  rank        Int
  percentile  Float
  ratingDelta Int
  pointsDelta Int
  createdAt   DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  season  Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([seasonId, createdAt])
}

model SeasonLeaderboard {
  id        String   @id @default(cuid())
  seasonId  String
  userId    String
  points    Int      @default(0)
  rank      Int?
  updatedAt DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@index([seasonId, points])
}

model SeasonRewardGrant {
  id         String            @id @default(cuid())
  seasonId   String
  userId     String
  rank       Int
  rewardType ContestRewardType
  amount     Int
  createdAt  DateTime          @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([seasonId, rank])
  @@index([userId, createdAt])
}

model UserProgression {
  id        String   @id @default(cuid())
  userId    String   @unique
  level     Int      @default(1)
  xp        Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CollectionProgression {
  id            String   @id @default(cuid())
  userId        String
  cardSetId     String?
  completionPct Float    @default(0)
  updatedAt     DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardSet CardSet? @relation(fields: [cardSetId], references: [id], onDelete: SetNull)

  @@unique([userId, cardSetId])
  @@index([userId])
}

model CompetitiveProgression {
  id              String   @id @default(cuid())
  userId          String   @unique
  contestsEntered Int      @default(0)
  contestsWon     Int      @default(0)
  rating          Int      @default(1000)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AdminActionStatus {
  VALIDATED
  EXECUTED
  FAILED
}

model AdminActionLog {
  id             String            @id @default(cuid())
  actionType     String
  module         String
  targetType     String?
  targetId       String?
  actorType      String
  actorId        String
  actorLabel     String
  authMode       String
  status         AdminActionStatus
  requestSummary Json?
  effectSummary  Json?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime          @default(now())

  @@index([module, createdAt])
  @@index([actionType, createdAt])
  @@index([targetType, targetId])
}

model AdminOpArtifact {
  id           String   @id @default(cuid())
  artifactType String
  targetType   String?
  targetId     String?
  payload      Json
  createdBy    String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([artifactType, createdAt])
  @@index([expiresAt])
}

enum AdminRole {
  ADMIN_OPS
  ADMIN_MODERATOR
  ADMIN_FINANCE_OPS
  ADMIN_SUPERVISOR
}

model AdminIdempotencyKey {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  actionType     String
  targetType     String?
  targetId       String?
  actorId        String
  actionLogId    String?
  createdAt      DateTime @default(now())

  @@index([actionType, createdAt])
  @@index([targetType, targetId])
}
