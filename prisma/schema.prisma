generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  xUserId         String        @unique
  xUsername       String
  displayName     String
  avatarUrl       String?
  authProvider    String        @default("x")
  points          Int           @default(300)
  packsOpened     Int           @default(0)
  pveBattleTickets Int          @default(3)
  lastPveResetAt  DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cards           UserCard[]
  packOpenings    PackOpening[]
  pveRuns         PveRun[]
  sessions        UserSession[]
}

model UserSession {
  id               String   @id @default(cuid())
  userId           String
  sessionTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserCard {
  id             String   @id @default(cuid())
  userId         String
  baseCardId     String
  quantity       Int      @default(0)
  pveExhausted   Boolean  @default(false)
  pveExhaustedAt DateTime?
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, baseCardId])
  @@index([userId])
}

model PackOpening {
  id        String   @id @default(cuid())
  userId    String
  packType  String
  result    Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PveRun {
  id              String   @id @default(cuid())
  userId          String
  difficulty      String
  selectedCards   Json
  enemyCards      Json
  result          String
  reward          Int
  bonusPackAwarded Boolean @default(false)
  battleMeta      Json
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
